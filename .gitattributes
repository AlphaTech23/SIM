* text=auto eol=lf

# Scripts et configuration destines au serveur Linux : toujours en LF,
# sinon bash renvoie "bad interpreter: /usr/bin/env bash^M".
deploy/*.sh       text eol=lf
deploy/*.sql      text eol=lf
deploy/*.conf     text eol=lf
deploy/*.service  text eol=lf
deploy/*.yml      text eol=lf
*.cmd             text eol=crlf
